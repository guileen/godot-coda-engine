{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/unit-registry@1",
  "title": "EmbodimentUnitRegistry@1",
  "type": "object",
  "required": ["contract_type", "schema_version", "registry_ref", "unit_system_ref", "units"],
  "properties": {
    "contract_type": { "const": "EmbodimentUnitRegistry" },
    "schema_version": { "const": 1 },
    "registry_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "unit_system_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["unit_ref", "dimension", "scale_to_si", "offset_to_si"],
        "properties": {
          "unit_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
          "dimension": { "$ref": "#/$defs/dimension" },
          "scale_to_si": { "type": "number", "exclusiveMinimum": 0 },
          "offset_to_si": { "type": "number" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["length", "mass", "time", "current", "temperature", "amount", "luminous_intensity", "angle"],
      "properties": {
        "length": { "type": "integer", "minimum": -12, "maximum": 12 },
        "mass": { "type": "integer", "minimum": -12, "maximum": 12 },
        "time": { "type": "integer", "minimum": -12, "maximum": 12 },
        "current": { "type": "integer", "minimum": -12, "maximum": 12 },
        "temperature": { "type": "integer", "minimum": -12, "maximum": 12 },
        "amount": { "type": "integer", "minimum": -12, "maximum": 12 },
        "luminous_intensity": { "type": "integer", "minimum": -12, "maximum": 12 },
        "angle": { "type": "integer", "minimum": -12, "maximum": 12 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
