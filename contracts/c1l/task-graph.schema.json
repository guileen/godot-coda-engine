{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/task-graph@1",
  "title": "CODA backend-neutral task graph",
  "type": "object",
  "required": ["graph_type", "graph_version", "event_id", "source_fingerprint", "nodes", "edges"],
  "properties": {
    "graph_type": { "const": "TaskGraph" },
    "graph_version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "source_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "kind", "contract_ref", "source_ref"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["task", "guard", "observation", "mode_transition", "tracking", "control", "intent", "reactive"] },
          "contract_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*@\\d+$" },
          "source_ref": { "$ref": "source-ref@1" },
          "activation_policy": { "enum": ["any_predecessor"] },
          "branch_context": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["guard_node_id", "outcome"],
              "properties": {
                "guard_node_id": { "type": "string", "minLength": 1 },
                "outcome": { "enum": ["true", "false"] }
              },
              "additionalProperties": false
            }
          },
          "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "branch_entries": {
            "type": "object",
            "required": ["true", "false"],
            "properties": {
              "true": { "type": "string", "minLength": 1 },
              "false": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "guard" } }, "required": ["kind"] },
            "then": { "required": ["branch_entries"] },
            "else": { "properties": { "branch_entries": false } }
          }
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["requires", "observes", "guards", "hands_off", "completes"] },
          "outcome": { "enum": ["true", "false", "pass", "reject", "unknown", "complete"] },
          "contract_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*@\\d+$" }
        },
        "allOf": [
          {
            "if": { "properties": { "relation": { "const": "hands_off" } }, "required": ["relation"] },
            "then": { "required": ["contract_ref"] },
            "else": { "properties": { "contract_ref": false } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
