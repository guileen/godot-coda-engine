{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/embodiment-dynamics-profile@1",
  "title": "CODA EmbodimentDynamicsProfile@1",
  "type": "object",
  "required": ["profile_type", "schema_version", "profile_id", "target_class", "target_identity", "status", "capability_refs", "unit_registry_ref", "reference_frame_registry_ref", "actuation_topology_ref", "contact_model_ref", "coupling_model_ref", "input_bounds_ref", "guarantee_level", "evidence_refs", "unsupported_policy"],
  "properties": {
    "profile_type": { "const": "EmbodimentDynamicsProfile" },
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[-\\w.]+@1$" },
    "target_class": { "enum": ["game_visual", "robot_simulation", "robot_hardware", "flight_simulation", "flight_hardware"] },
    "target_identity": { "type": "object", "required": ["vendor", "model", "hardware_revision", "software_revision"], "properties": { "vendor": { "type": "string" }, "model": { "type": "string" }, "hardware_revision": { "type": "string" }, "software_revision": { "type": "string" } }, "additionalProperties": false },
    "status": { "enum": ["draft", "measured", "calibrated", "approved"] },
    "capability_refs": { "type": "array", "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true },
    "unit_registry_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "reference_frame_registry_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "actuation_topology_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "contact_model_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "coupling_model_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "input_bounds_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "guarantee_level": { "enum": ["visual_plausibility", "model_admissible", "calibrated_envelope", "hardware_safety_reviewed"] },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "unsupported_policy": { "enum": ["reject", "explicit_fallback"] }
  },
  "additionalProperties": false
}
