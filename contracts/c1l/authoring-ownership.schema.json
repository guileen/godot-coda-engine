{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/authoring-ownership@1",
  "title": "CODA AuthoringOwnership@1",
  "type": "object",
  "required": ["contract_type", "schema_version", "asset_id", "authoring_mode", "owner_revision", "source", "node_identity", "derived_projections"],
  "properties": {
    "contract_type": { "const": "AuthoringOwnership" },
    "schema_version": { "const": 1 },
    "asset_id": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "authoring_mode": { "enum": ["text_owned", "graph_owned"] },
    "owner_revision": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "required": ["source_type", "source_ref", "fingerprint"],
      "properties": {
        "source_type": { "enum": ["coda_source", "event_asset"] },
        "source_ref": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "node_identity": {
      "type": "object",
      "required": ["policy", "mapping_digest"],
      "properties": {
        "policy": { "const": "stable_node_id@1" },
        "mapping_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "derived_projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "fingerprint", "authority", "writable"],
        "properties": {
          "artifact_type": { "enum": ["event_asset", "coda_projection", "execution_plan", "generated_code"] },
          "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "authority": { "const": "derived" },
          "writable": { "const": false }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "authoring_mode": { "const": "text_owned" } } }, "then": { "properties": { "source": { "properties": { "source_type": { "const": "coda_source" } } } } } },
    { "if": { "properties": { "authoring_mode": { "const": "graph_owned" } } }, "then": { "properties": { "source": { "properties": { "source_type": { "const": "event_asset" } } } } } }
  ],
  "additionalProperties": false
}
