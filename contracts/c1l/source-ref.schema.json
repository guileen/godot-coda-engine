{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/source-ref@1",
  "title": "CODA stable source reference",
  "type": "object",
  "required": ["event_id", "node_id", "path"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "node_id": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^/" },
    "field_id": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "object", "additionalProperties": { "$ref": "#" } }
  },
  "additionalProperties": false
}
