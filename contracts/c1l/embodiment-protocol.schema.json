{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/embodiment-protocol@1",
  "title": "CODA EmbodimentProtocol@1 port message",
  "type": "object",
  "required": ["protocol", "schema_version", "message_id", "direction", "message_type", "adapter_ref", "epoch", "sequence", "clock", "validity", "payload"],
  "properties": {
    "protocol": { "const": "EmbodimentProtocol" },
    "schema_version": { "const": 1 },
    "message_id": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["coda_to_adapter", "adapter_to_coda"] },
    "message_type": { "enum": ["capability_query", "capability_report", "observation", "reference", "mode_request", "authority_lease", "handoff", "barrier_receipt", "start_receipt", "transition_receipt", "terminal_receipt", "reject"] },
    "adapter_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "epoch": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "clock": { "type": "object", "required": ["domain", "tick", "quality"], "properties": { "domain": { "type": "string", "minLength": 1 }, "tick": { "type": "integer", "minimum": 0 }, "quality": { "enum": ["synchronized", "bounded_skew", "uncertain", "invalid"] } }, "additionalProperties": false },
    "validity": { "type": "object", "required": ["valid_from_tick", "valid_until_tick"], "properties": { "valid_from_tick": { "type": "integer", "minimum": 0 }, "valid_until_tick": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "lease_ref": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object", "minProperties": 1 }
  },
  "allOf": [
    { "if": { "properties": { "message_type": { "const": "capability_query" } } }, "then": { "properties": { "direction": { "const": "coda_to_adapter" }, "payload": { "required": ["profile_ref", "minimum_protocol_version"], "properties": { "profile_ref": { "type": "string" }, "minimum_protocol_version": { "const": 1 } } } } } },
    { "if": { "properties": { "message_type": { "const": "capability_report" } } }, "then": { "properties": { "direction": { "const": "adapter_to_coda" }, "payload": { "required": ["capabilities", "adapter_revision", "profile_status"], "properties": { "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true }, "adapter_revision": { "type": "string", "minLength": 1 }, "profile_status": { "enum": ["available", "degraded", "unsupported"] } } } } } },
    { "if": { "properties": { "message_type": { "const": "observation" } } }, "then": { "properties": { "direction": { "const": "adapter_to_coda" }, "payload": { "required": ["snapshot_ref", "quality", "reference_frame", "unit_system"], "properties": { "snapshot_ref": { "type": "string", "minLength": 1 }, "quality": { "enum": ["valid", "degraded", "stale", "invalid"] }, "reference_frame": { "type": "string", "minLength": 1 }, "unit_system": { "type": "string", "minLength": 1 } } }, "lease_ref": { "type": "string" }, "generation": { "type": "integer", "minimum": 0 } } } },
    { "if": { "properties": { "message_type": { "const": "reference" } } }, "then": { "properties": { "direction": { "const": "coda_to_adapter" }, "payload": { "required": ["representation", "reference_ref", "constraints_ref"], "properties": { "representation": { "enum": ["segment", "spline", "setpoint_sequence", "local_policy", "hold_reference"] }, "reference_ref": { "type": "string", "minLength": 1 }, "constraints_ref": { "type": "string", "minLength": 1 } } }, "lease_ref": { "type": "string", "minLength": 1 }, "generation": { "type": "integer", "minimum": 0 } }, "required": ["lease_ref", "generation"] } },
    { "if": { "properties": { "message_type": { "const": "mode_request" } } }, "then": { "properties": { "direction": { "const": "coda_to_adapter" }, "payload": { "required": ["controller_ref", "mode_ref", "handoff_contract_ref"], "properties": { "controller_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "mode_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "handoff_contract_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" } } } } } },
    { "if": { "properties": { "message_type": { "const": "authority_lease" } } }, "then": { "properties": { "direction": { "const": "coda_to_adapter" }, "payload": { "required": ["lease_id", "owner", "resources", "valid_until_tick"], "properties": { "lease_id": { "type": "string", "minLength": 1 }, "owner": { "const": "coda" }, "resources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true }, "valid_until_tick": { "type": "integer", "minimum": 0 } } }, "lease_ref": { "type": "string", "minLength": 1 }, "generation": { "type": "integer", "minimum": 0 } }, "required": ["lease_ref", "generation"] } },
    { "if": { "properties": { "message_type": { "const": "handoff" } } }, "then": { "properties": { "direction": { "const": "coda_to_adapter" }, "payload": { "required": ["handoff_contract_ref", "incoming_controller_ref", "barrier_id"], "properties": { "handoff_contract_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "incoming_controller_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "barrier_id": { "type": "string", "minLength": 1 } } } } } },
    { "if": { "properties": { "message_type": { "enum": ["barrier_receipt", "start_receipt", "transition_receipt", "terminal_receipt"] } } }, "then": { "properties": { "direction": { "const": "adapter_to_coda" }, "payload": { "required": ["receipt_id", "status", "partial_write"], "properties": { "receipt_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["accepted", "started", "completed", "failed", "rejected", "stale", "owner_lost"] }, "partial_write": { "const": false } }, "additionalProperties": false }, "lease_ref": { "type": "string", "minLength": 1 }, "generation": { "type": "integer", "minimum": 0 } }, "required": ["lease_ref", "generation"] } },
    { "if": { "properties": { "message_type": { "const": "reject" } } }, "then": { "properties": { "direction": { "const": "adapter_to_coda" }, "payload": { "required": ["code", "partial_write"], "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }, "partial_write": { "const": false } }, "additionalProperties": false } } } }
  ],
  "additionalProperties": false
}
