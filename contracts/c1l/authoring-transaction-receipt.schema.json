{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/authoring-transaction-receipt@1",
  "title": "CODA AuthoringTransactionReceipt@1",
  "type": "object",
  "required": ["receipt_type", "schema_version", "transaction_id", "status", "asset_id", "authoring_mode", "owner_revision", "source_fingerprint", "changed_node_ids", "diagnostics"],
  "properties": {
    "receipt_type": { "const": "AuthoringTransactionReceipt" },
    "schema_version": { "const": 1 },
    "transaction_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["committed", "rejected", "conflict", "stale_owner"] },
    "asset_id": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "authoring_mode": { "enum": ["text_owned", "graph_owned"] },
    "owner_revision": { "type": "integer", "minimum": 0 },
    "source_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "changed_node_ids": { "type": "array", "items": { "type": "string", "pattern": "^[-\\w.]+$" }, "uniqueItems": true },
    "invalidated_projection_fingerprints": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "uniqueItems": true },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } }, "additionalProperties": false } }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "committed" } } }, "then": { "properties": { "diagnostics": { "maxItems": 0 } } } },
    { "if": { "properties": { "status": { "enum": ["conflict", "stale_owner"] } } }, "then": { "properties": { "changed_node_ids": { "maxItems": 0 } } } }
  ],
  "additionalProperties": false
}
