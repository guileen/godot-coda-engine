{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1l/embodied-skill@1",
  "title": "CODA EmbodiedSkill@1",
  "type": "object",
  "required": ["contract_type", "schema_version", "skill_id", "authoring_owner", "actor_kind", "parameter_schema_ref", "required_capabilities", "observations", "phases", "resume_policy", "on_no_solution", "postconditions"],
  "properties": {
    "contract_type": { "const": "EmbodiedSkill" },
    "schema_version": { "const": 1 },
    "skill_id": { "type": "string", "pattern": "^[-\\w.]+@1$" },
    "authoring_owner": { "const": "text_owned" },
    "actor_kind": { "enum": ["humanoid", "mobile_robot", "manipulator", "vehicle", "game_character", "profile_defined"] },
    "parameter_schema_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "required_capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true },
    "observations": { "type": "array", "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase_id", "progress_domain", "task_refs", "completion_guard_ref"],
        "properties": {
          "phase_id": { "type": "string", "pattern": "^[-\\w.]+$" },
          "progress_domain": { "const": [0, 1] },
          "task_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true },
          "completion_guard_ref": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
          "checkpoint_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "resume_policy": { "enum": ["exact_phase", "compatible_phase", "checkpoint", "replan_remaining", "reject"] },
    "on_no_solution": { "enum": ["reject", "recovery_skill", "yield_safety_authority"] },
    "postconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
