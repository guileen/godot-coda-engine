{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/coda/motion-intent@1",
  "title": "CODA MotionIntent contract",
  "type": "object",
  "required": ["opcode", "target", "args", "source_ref"],
  "properties": {
    "opcode": { "const": "MotionIntent" },
    "target": { "type": "string", "pattern": "^[-\\w.]+@\\d+$" },
    "args": {
      "type": "object",
      "required": ["target", "resources", "priority", "safety_profile", "on_no_solution"],
      "properties": {
        "target": { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "type": "string", "minLength": 1 } } },
        "resources": { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "type": "string", "pattern": "@\\d+" } } },
        "priority": { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "type": "integer", "minimum": 0, "maximum": 100 } } },
        "safety_profile": { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "type": "string", "pattern": "@\\d+" } } },
        "on_no_solution": { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "enum": ["reject", "fallback", "safe_stop"] } } }
      },
      "additionalProperties": true
    },
    "source_ref": { "type": "object", "required": ["event_id", "node_id", "path"] }
  },
  "additionalProperties": false
}
