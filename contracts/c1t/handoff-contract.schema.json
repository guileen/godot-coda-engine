{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1t/handoff-contract@1",
  "title": "C1-T HandoffContract",
  "type": "object",
  "required": ["contract_type", "schema_version", "contract_id", "outgoing_controller_ref", "incoming_controller_ref", "authority_barrier", "reconstruction", "command_match", "blend_policy", "safety_profile_ref", "on_failure"],
  "properties": {
    "contract_type": { "const": "HandoffContract" },
    "schema_version": { "const": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "outgoing_controller_ref": { "type": "string", "pattern": "@1$" },
    "incoming_controller_ref": { "type": "string", "pattern": "@1$" },
    "authority_barrier": { "const": "atomic_single_writer" },
    "reconstruction": {
      "type": "object",
      "required": ["method", "required_inputs", "compatibility_evidence_ref"],
      "properties": {
        "method": { "enum": ["versioned_translate", "observable_reconstruct", "controlled_reset_warmup", "reject_direct_handoff"] },
        "translator_ref": { "type": "string", "pattern": "@1$" },
        "required_inputs": { "type": "array", "minItems": 3, "items": { "enum": ["measured_state", "last_commanded_state", "last_desired_state", "outgoing_effort", "contact_state", "energy_state"] }, "uniqueItems": true },
        "compatibility_evidence_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "command_match": {
      "type": "object",
      "required": ["channels", "continuity_envelope_ref"],
      "properties": {
        "channels": { "type": "array", "minItems": 1, "items": { "enum": ["position", "velocity", "acceleration", "effort", "effort_rate", "gravity_support", "contact_wrench"] }, "uniqueItems": true },
        "continuity_envelope_ref": { "type": "string", "pattern": "@1$" }
      },
      "additionalProperties": false
    },
    "blend_policy": {
      "type": "object",
      "required": ["mode", "admission_checks"],
      "properties": {
        "mode": { "enum": ["none", "profile_ref"] },
        "profile_ref": { "type": "string", "pattern": "@1$" },
        "admission_checks": { "type": "array", "items": { "enum": ["effort", "effort_rate", "saturation", "contact", "passivity_energy", "closed_loop_domain"] }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "safety_profile_ref": { "type": "string", "pattern": "@1$" },
    "on_failure": { "enum": ["keep_outgoing_if_still_valid", "enter_certified_backup", "yield_safety_authority", "reject"] }
  },
  "additionalProperties": false
}
