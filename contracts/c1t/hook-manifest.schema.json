{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1t/hook-manifest@1",
  "title": "C1-T trusted HookManifest",
  "type": "object",
  "required": ["manifest_type", "schema_version", "hooks", "trust_boundary", "fallback_policy"],
  "properties": {
    "manifest_type": { "const": "HookManifest" },
    "schema_version": { "const": 1 },
    "hooks": { "type": "array", "items": { "type": "object", "required": ["hook_id", "version", "order", "artifact_sha256", "input_schema", "output_schema", "determinism", "work_budget", "wall_watchdog_ms", "failure_codes"], "properties": { "hook_id": { "type": "string" }, "version": { "const": 1 }, "order": { "type": "integer", "minimum": 0 }, "artifact_sha256": { "type": "string", "pattern": "^sha256:" }, "input_schema": { "type": "string" }, "output_schema": { "type": "string" }, "determinism": { "const": "trusted_deterministic" }, "work_budget": { "type": "integer", "minimum": 1 }, "wall_watchdog_ms": { "type": "integer", "minimum": 1 }, "failure_codes": { "type": "array", "minItems": 1 } } } },
    "trust_boundary": { "type": "object", "required": ["allow_third_party", "allow_learning_models", "execution_mode"], "properties": { "allow_third_party": { "const": false }, "allow_learning_models": { "const": false }, "execution_mode": { "const": "repository_trusted_only" } } },
    "fallback_policy": { "type": "object", "required": ["max_depth", "resource_rule", "safety_rule", "runtime_selects"], "properties": { "max_depth": { "const": 1 }, "resource_rule": { "const": "same_or_subset" }, "safety_rule": { "const": "never_relax" }, "runtime_selects": { "const": true } } }
  },
  "additionalProperties": false
}
