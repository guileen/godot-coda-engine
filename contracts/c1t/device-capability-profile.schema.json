{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coda://contracts/c1t/device-capability-profile@1",
  "title": "C1-T DeviceCapabilityProfile",
  "type": "object",
  "required": ["profile_type", "schema_version", "profile_id", "target_class", "target_identity", "status", "clock_domains", "timing_budget_refs", "controller_modes", "start_tube_representations", "joint_admission_checker_ref", "safety_profile_ref", "evidence_refs"],
  "properties": {
    "profile_type": { "const": "DeviceCapabilityProfile" },
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "target_class": { "enum": ["game_visual", "robot_simulation", "robot_hardware", "flight_simulation", "flight_hardware"] },
    "target_identity": { "type": "object", "required": ["vendor", "model", "hardware_revision", "software_revision"] },
    "status": { "enum": ["draft", "measured", "calibrated", "approved"] },
    "clock_domains": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "role", "evidence_ref"] } },
    "timing_budget_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "controller_modes": { "type": "array", "items": { "type": "string", "pattern": "@1$" }, "uniqueItems": true },
    "start_tube_representations": { "type": "array", "items": { "enum": ["aabb", "diagonal_ellipsoid", "dense_ellipsoid", "fixed_polytope", "zonotope", "profile_predicate"] }, "uniqueItems": true },
    "joint_admission_checker_ref": { "type": "string", "pattern": "@1$" },
    "safety_profile_ref": { "type": "string", "pattern": "@1$" },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "additionalProperties": false
}
