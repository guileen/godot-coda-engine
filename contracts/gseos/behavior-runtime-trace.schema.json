{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guileen/godot-coda-engine/blob/main/contracts/gseos/behavior-runtime-trace.schema.json",
  "title": "CODA BehaviorRuntimeTrace@1",
  "type": "object",
  "required": ["trace_type", "schema_version", "behavior_id", "event_asset_id", "plan_fingerprint", "final_state", "blackboard", "entries"],
  "properties": {
    "trace_type": { "const": "BehaviorRuntimeTrace" },
    "schema_version": { "const": 1 },
    "behavior_id": { "type": "string" },
    "event_asset_id": { "type": "string" },
    "plan_fingerprint": { "type": "string", "pattern": "^sha256:" },
    "final_state": { "type": "string" },
    "blackboard": { "type": "object" },
    "entries": { "type": "array", "items": { "type": "object", "required": ["entry_id", "kind", "source_ref"], "properties": { "entry_id": { "type": "integer", "minimum": 1 }, "kind": { "enum": ["EventArbitrated", "EventRejected", "EventIgnored", "StateTransition", "BlackboardWritten", "EffectStarted", "EffectCompleted", "EffectCancelled", "EffectConverged"] }, "source_ref": { "type": "object", "required": ["event_id", "path"], "properties": { "event_id": { "type": "string" }, "node_id": { "type": "string" }, "field_id": { "type": "string" }, "path": { "type": "string" } }, "additionalProperties": true } }, "additionalProperties": true } }
  },
  "additionalProperties": false
}
