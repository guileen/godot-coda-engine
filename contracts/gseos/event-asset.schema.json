{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guileen/godot-coda-engine/blob/main/contracts/gseos/event-asset.schema.json",
  "title": "GSEOS EventAsset@1",
  "type": "object",
  "required": ["asset_type", "schema_version", "event_id", "display_name", "args", "root"],
  "properties": {
    "asset_type": { "const": "EventAsset" },
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "args": { "type": "array", "items": { "$ref": "#/$defs/typedValue" } },
    "owner": { "type": ["object", "null"] },
    "reentry": { "enum": ["reject", "replace", "parallel"] },
    "recovery": { "enum": ["E0", "E1", "E2"] },
    "root": { "type": "array", "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "typedValue": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["node_id", "command_id", "params"],
      "properties": {
        "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "command_id": { "type": "string" },
        "params": { "type": "object" },
        "children": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/node" } } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
