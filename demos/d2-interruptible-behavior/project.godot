; Engine configuration file.
config_version=5

[application]
config/name="CODA D2 Interruptible Behavior"
run/main_scene="res://scenes/d2_interruptible_behavior.tscn"

[display]
window/size/viewport_width=1180
window/size/viewport_height=720
window/size/window_width_override=1180
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.06, 0.11, 1)
